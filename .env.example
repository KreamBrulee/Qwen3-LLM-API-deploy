# Llama.cpp server (local only)
LLAMA_BASE_URL=http://127.0.0.1:8080

# Proxy server
PROXY_HOST=127.0.0.1
PROXY_PORT=8001

# Security
API_KEYS=replace-with-strong-key-1,replace-with-strong-key-2
REQUESTS_PER_MINUTE=30
MAX_PROMPT_CHARS=20000
MAX_TOKENS_PER_REQUEST=1024
REQUEST_TIMEOUT_SECONDS=120

# Optional strict model pin (must match the model llama-server is serving)
ALLOWED_MODEL=qwen25-coder-3b-stackoverflow-q4_k_m

# Users, sessions, and history (optional — defaults shown)
DB_PATH=stackmind.db
HISTORY_CONTEXT_MESSAGES=20
SESSION_TTL_DAYS=30
SUMMARY_UPDATE_EVERY=10

# Comma-separated usernames that get admin on registration
ADMIN_USERNAMES=
